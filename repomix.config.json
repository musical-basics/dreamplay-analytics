{
    "output": {
        "filePath": "../dreamplay-analytics-repomix.xml",
        "style": "xml",
        "headerText": "DreamPlay Analytics Codebase"
    },
    "ignore": {
        "useGitignore": true,
        "useDefaultPatterns": true,
        "customPatterns": [
            "**/node_modules/**",
            "**/.next/**",
            "**/.git/**",
            "**/.vercel/**",
            "**/dist/**",
            "**/coverage/**",
            "**/pnpm-lock.yaml",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/*.ico",
            "**/*.png",
            "**/*.jpg",
            "**/*.jpeg",
            "**/*.svg",
            "**/*.gif",
            "**/*.woff",
            "**/*.woff2",
            "**/.DS_Store",
            "**/.env",
            "**/.env.*",
            "**/README.md",
            "**/repomix.config.json",
            "**/next-env.d.ts",
            "**/tsconfig.tsbuildinfo",
            "**/deploy-and-watch.sh",
            "**/*repomix*.xml"
        ]
    }
}